{
  "name": "devgonerogue/supamask",
  "description": "A lightweight PHP security middleware library for IP, bot, challenge, and traffic intelligence controls.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/vulpesbase/supamask",
  "keywords": [
    "php",
    "middleware",
    "security",
    "ip-blocking",
    "bot-blocking",
    "ip-intelligence",
    "vpn-detection",
    "asn"
  ],
  "autoload": {
    "psr-4": {
      "Supamask\\": "src/"
    }
  },
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "*"
  },
  "autoload-dev": {
    "psr-4": {
      "Supamask\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
